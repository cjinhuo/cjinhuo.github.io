---

<section class="max-w-5xl mx-auto px-6 md:px-12 py-12" aria-labelledby="projects-heading">
  <h1 id="projects-heading" class="text-2xl font-semibold text-skin-neutral-1">Open-source projects by Shanks</h1>
  <ul class="mt-6 grid gap-x-10 gap-y-6 sm:grid-cols-2">
    {projects.map(({ name, url, description, links }) => (
      <li>
        <a class="font-semibold text-skin-primary underline underline-offset-4" href={url}>{name}</a>
        <p class="mt-1 text-skin-neutral-4">{description}</p>
        {links.length > 0 && (
          <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {links.map(({ label, url, lang }) => (
              <li><a class="text-skin-primary underline underline-offset-4" href={url} lang={lang}>{label}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</section>
